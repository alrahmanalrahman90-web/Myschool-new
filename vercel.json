{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/search.js": {
      "maxDuration": 15
    },
    "api/video.js": {
      "maxDuration": 20
    },
    "api/lyrics.js": {
      "maxDuration": 12
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}